# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------

# URL del proyecto (publica, se usa desde el navegador y desde el servidor)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave anonima (publica). Solo puede INSERTAR en preinscripciones por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service role (SECRETA). Nunca la publiques ni la uses en el cliente:
# se usa solo en el servidor para leer una preinscripcion al verificar el QR.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Dominio publico del sitio (opcional)
# ---------------------------------------------------------------------------
# Define la URL absoluta que se codifica dentro del QR.
# Si se deja vacia, se deduce del host del pedido (o de VERCEL_URL).
# Conviene fijarla en produccion con el dominio definitivo, sin barra final.
NEXT_PUBLIC_SITE_URL=https://fiesta.smt.gob.ar

# ---------------------------------------------------------------------------
# Limite de preinscripciones por IP (opcional)
# ---------------------------------------------------------------------------
# Clave para hashear las IP en la tabla de intentos. Nunca se guarda la IP en
# claro. Si se deja vacia se usa la service role key como clave de hash, asi
# que la app funciona igual; definirla es mas prolijo.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALT_IP=
